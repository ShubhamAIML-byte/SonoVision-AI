{
  "project_name": "SonoVision AI",
  "model_architecture": "Vision Transformer (ViT-B/16)",
  "backbone": "vit_base_patch16_224",
  "image_size": [224, 224],
  "patch_size": 16,
  "num_patches": 196,
  "hidden_dimension": 768,
  "transformer_encoder_layers": 12,
  "attention_heads": 12,
  "mlp_ratio": 4.0,
  "dropout": 0.1,
  "normalization": {
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "interpolation": "bilinear",
  "classes": ["benign", "malignant", "normal"],
  "num_classes": 3,
  "batch_size": 16,
  "optimizer": "AdamW",
  "learning_rate": 3e-5,
  "weight_decay": 0.01,
  "scheduler": "CosineAnnealingLR",
  "explainability": {
    "method": "ViT Patch-Token Grad-CAM",
    "target_layer": "encoder.layers.11.ln_1",
    "colormap": "cv2.COLORMAP_JET",
    "default_alpha": 0.55
  }
}
